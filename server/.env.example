# Required: the bearer token every client (SDK, MCP, web UI) sends.
SUPERMEM_API_KEY=change-me
DATABASE_URL=postgres://localhost/supermem
PORT=6767
HOST=127.0.0.1
# Any OpenAI-compatible endpoint. Default: local Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
# LLM_API_KEY=
# Space used by MCP tools when none is given/selected.
SUPERMEM_DEFAULT_SPACE=sm_project_default
