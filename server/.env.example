# Required: the bearer token every client (SDK, MCP, web UI) sends.
SUPERMEM_API_KEY=change-me
DATABASE_URL=postgres://localhost/supermem
PORT=6767
HOST=127.0.0.1
# Any OpenAI-compatible endpoint. Default: local Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
# LLM_API_KEY=
# Per-role model override: LLM_MODEL_EXTRACT, LLM_MODEL_GROUND, LLM_MODEL_RELATE, LLM_MODEL_DERIVE, LLM_MODEL_FORGET, LLM_MODEL_CHAT.
# LLM_TIMEOUT_MS=300000
# Output cap per role (defaults: extract 2500, ground 600, relate 800, derive 500, forget 400, chat 2000, judge 800).
# LLM_MAX_TOKENS_EXTRACT=2500
# Dreamer v2: GROUND_LLM=off skips the LLM half of grounding (the quote/speaker/date checks in code still run).
# GROUND_LLM=on
# An UPDATE below this confidence becomes a conflict review item instead of superseding (default in lifecycle.yaml).
# RELATE_UPDATE_MIN=0.75
# Memory lifecycle constants (decay, strength cap): server/lifecycle.yaml, or another file here.
# LIFECYCLE_FILE=
# Responses are cached in Postgres (llm_cache) so re-runs are cheap and deterministic. Set to off to bypass.
# LLM_CACHE=on
# Secret guard: API keys, tokens, passwords and card numbers are replaced with [REDACTED:<kind>] before anything is
# stored or sent to a model. true keeps the original document text (raw) as sent; chunks and memories stay redacted.
# STORE_RAW_SECRETS=false
# Tests only: any database on the test server; the role needs createdb. Default postgres://localhost/postgres
# TEST_DATABASE_URL=
# Space used by MCP tools when none is given/selected.
SUPERMEM_DEFAULT_SPACE=sm_project_default
